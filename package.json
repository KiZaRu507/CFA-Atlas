{
  "name": "cfa-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "audit:content": "node scripts/audit.mjs",
    "content:rebuild": "python3 scripts/build_content.py && python3 scripts/expand_calculations.py && python3 scripts/expand_conceptual.py"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "@vitejs/plugin-react": "5.0.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@types/node": "24.3.0"
  }
}
